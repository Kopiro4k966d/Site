# Скопируйте в .env (локально) или задайте в переменных окружения хостинга. Файл .env никому не отправляйте.
DATABASE_URL=postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require
SITE_URL=https://ваш-домен.ru
# npm run keys -> приватный ключ сюда, публичный в app/config.json
LICENSE_PRIVATE_KEY=
# боевая оплата ЮKassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET=
# Админка партнёров (/admin.html): длинная случайная строка, не короче 24 символов
ADMIN_KEY=
# ТОЛЬКО для проверки на тестовом сайте: тариф включается без оплаты. На боевом НЕ задавать
# DEMO_PAY=1

# Вход через Discord и Google (инструкция: ВХОД_DISCORD_GOOGLE.md). Любой провайдер можно не задавать, его кнопка останется «скоро».
# Случайная строка от 32 символов: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
